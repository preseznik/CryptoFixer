<Window x:Class="CryptoFixer.MachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add remote machine" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="#1F2328"
        UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="Host name or IP address" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="HostBox" Padding="6,5" MaxLength="253" AutomationProperties.Name="Host name or IP address" />
        <TextBlock Text="For example srv01, srv01.contoso.com, 10.0.0.5 or fe80::1. No port or URL." FontSize="11.5"
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Display name" FontWeight="SemiBold" Margin="0,12,0,4" />
        <TextBox x:Name="NameBox" Padding="6,5" MaxLength="64" AutomationProperties.Name="Display name" />
        <TextBlock Text="Optional. Defaults to the host name." FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />

        <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,12,0,4" />
        <ComboBox x:Name="ProtocolBox" Padding="6,4" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Connection" />

        <TextBlock Text="Credentials" FontWeight="SemiBold" Margin="0,14,0,6" />
        <RadioButton x:Name="CurrentAccountRadio" GroupName="Credentials" Checked="OnCredentialModeChanged"
                     Content="Use my current Windows account" />
        <RadioButton x:Name="OtherAccountRadio" GroupName="Credentials" Checked="OnCredentialModeChanged" Margin="0,6,0,0"
                     Content="Use another account" />

        <Grid x:Name="AccountFields" Margin="22,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="User name" VerticalAlignment="Center" />
            <TextBox x:Name="UserBox" Grid.Column="1" Padding="6,5" AutomationProperties.Name="User name" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="DOMAIN\user, user@domain, or .\user for a local account on the target."
                       FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,8" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center" />
            <PasswordBox x:Name="PasswordInput" Grid.Row="2" Grid.Column="1" Padding="6,5" AutomationProperties.Name="Password" />
            <TextBlock x:Name="KeepPasswordHint" Grid.Row="3" Grid.Column="1" Text="A password is saved. Leave this blank to keep it."
                       FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" Visibility="Collapsed" />

            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                <CheckBox x:Name="SavePasswordBox" Content="Save the password (encrypted)" />
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                           Text="Saved passwords are encrypted with Windows DPAPI for your Windows account. Only the same Windows user on this PC can decrypt them; anywhere else CryptoFixer asks for the password again. Passwords that aren't saved are kept in memory until CryptoFixer closes, and are never shown or logged." />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="#CF222E" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <TextBlock x:Name="FileText" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Add machine" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OnSave" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
