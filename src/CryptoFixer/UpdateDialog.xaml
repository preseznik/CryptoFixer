<Window x:Class="CryptoFixer.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update CryptoFixer" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="#1F2328"
        UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBox x:Name="NotesBox" IsReadOnly="True" Height="190" Padding="6,5" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Release notes" />
        <TextBlock Margin="0,6,0,0">
            <Hyperlink x:Name="ReleaseLink" Click="OnReleaseLinkClick">
                <Run x:Name="ReleaseLinkText" />
            </Hyperlink>
        </TextBlock>

        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Margin="0,14,0,0" />

        <Border x:Name="BlockerPanel" Background="#FFF8C5" BorderBrush="#E7D38B" BorderThickness="1" CornerRadius="6"
                Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="BlockerText" TextWrapping="Wrap" />
        </Border>

        <Border x:Name="PendingPanel" Background="#FFEBE9" BorderBrush="#F5B5B0" BorderThickness="1" CornerRadius="6"
                Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="PendingText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="PrimaryButton" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OnPrimaryClick" />
            <Button Content="Not now" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
