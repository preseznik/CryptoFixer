<Window x:Class="CryptoFixer.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="#1F2328"
        UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Foreground="#9A6700" Margin="0,0,0,10" Visibility="Collapsed" />
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />

        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordInput" Padding="6,5" AutomationProperties.Name="Password" />

        <CheckBox x:Name="SavePasswordBox" Content="Save the password (encrypted)" Margin="0,10,0,0" />
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                   Text="Saved passwords are encrypted with Windows DPAPI and only decrypt for the same Windows user on this PC. Otherwise the password is kept in memory until CryptoFixer closes." />

        <TextBlock x:Name="ErrorText" Foreground="#CF222E" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Connect" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OnConnect" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
