<Window x:Class="CryptoFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CryptoFixer.ViewModels"
    xmlns:controls="clr-namespace:CryptoFixer.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CryptoFixer — Schannel protocol manager"
        Width="1120" Height="760" MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1F2328"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type vm:ProtocolCellViewModel}">
            <StackPanel Margin="8,7" ToolTip="{Binding ToolTip}" Background="Transparent" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="250" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PendingFrame" CornerRadius="5" Padding="2" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                        <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="6,4" AutomationProperties.Name="{Binding AccessibleName}" />
                    </Border>
                </Grid>

                <DockPanel Margin="4,4,0,0">
                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,7,0" VerticalAlignment="Top" Fill="#1A7F37" />
                    <WrapPanel>
                        <TextBlock x:Name="EffectiveText" Text="{Binding EffectiveText}" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </WrapPanel>
                </DockPanel>
                <TextBlock Text="{Binding PendingText}" Foreground="#9A6700" FontSize="11.5" FontWeight="SemiBold" Margin="20,1,0,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="#CF222E" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="#CF222E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Attention">
                    <Setter TargetName="Dot" Property="Fill" Value="#BF8700" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="#9A6700" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Neutral">
                    <Setter TargetName="Dot" Property="Fill" Value="#AFB8C1" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="PendingFrame" Property="Background" Value="#FFF1C2" />
                    <Setter TargetName="PendingFrame" Property="BorderBrush" Value="#D4A72C" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Compact: setting, state, source and pending change on one line. -->
        <DataTemplate x:Key="CompactCellTemplate" DataType="{x:Type vm:ProtocolCellViewModel}">
            <DockPanel Margin="8,3" ToolTip="{Binding ToolTip}" Background="Transparent" VerticalAlignment="Center">
                <Border x:Name="PendingFrame" DockPanel.Dock="Left" Width="164" CornerRadius="4" Padding="1" BorderThickness="1"
                        BorderBrush="Transparent" Background="Transparent">
                    <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Padding="5,2" AutomationProperties.Name="{Binding AccessibleName}" />
                </Border>
                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="10,0,6,0" VerticalAlignment="Center" Fill="#1A7F37" />
                <DockPanel VerticalAlignment="Center" LastChildFill="True">
                    <TextBlock x:Name="EffectiveText" DockPanel.Dock="Left" Text="{Binding EffectiveText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SourceText" DockPanel.Dock="Left" Text="{Binding ShortSourceText}" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShortPendingText}" Foreground="#9A6700" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center" ToolTip="{Binding PendingText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="#CF222E" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="#CF222E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Attention">
                    <Setter TargetName="Dot" Property="Fill" Value="#BF8700" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="#9A6700" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Neutral">
                    <Setter TargetName="Dot" Property="Fill" Value="#AFB8C1" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="PendingFrame" Property="Background" Value="#FFF1C2" />
                    <Setter TargetName="PendingFrame" Property="BorderBrush" Value="#D4A72C" />
                    <!-- Make room for "→ new state"; the source is still in the tooltip. -->
                    <Setter TargetName="SourceText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- List: one side (server or client) of a list item, laid out inline. -->
        <DataTemplate x:Key="ListSideTemplate" DataType="{x:Type vm:ProtocolCellViewModel}">
            <Grid Margin="0,0,28,4" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="196" />
                    <!-- Shared across all cards so the Client side lines up. -->
                    <ColumnDefinition Width="Auto" MinWidth="170" SharedSizeGroup="ListSideState" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" />
                <Border x:Name="PendingFrame" Grid.Column="1" CornerRadius="5" Padding="1" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                    <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Padding="6,3" AutomationProperties.Name="{Binding AccessibleName}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#1A7F37" />
                    <TextBlock x:Name="EffectiveText" Text="{Binding EffectiveText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ShortSourceText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PendingText}" Foreground="#9A6700" FontSize="11.5"
                           FontWeight="SemiBold" Margin="2,3,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="#CF222E" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="#CF222E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Attention">
                    <Setter TargetName="Dot" Property="Fill" Value="#BF8700" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="#9A6700" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Neutral">
                    <Setter TargetName="Dot" Property="Fill" Value="#AFB8C1" />
                    <Setter TargetName="EffectiveText" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="PendingFrame" Property="Background" Value="#FFF1C2" />
                    <Setter TargetName="PendingFrame" Property="BorderBrush" Value="#D4A72C" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grid column cell templates; MainWindow.xaml.cs swaps them when the display mode changes. -->
        <DataTemplate x:Key="ProtocolCellTemplate" DataType="{x:Type vm:ProtocolRowViewModel}">
            <StackPanel Margin="16,8,8,8" VerticalAlignment="Center">
                <WrapPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0" />
                    <Border Background="#FFEBE9" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                            Visibility="{Binding IsDeprecated, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="deprecated" FontSize="11" Foreground="#A40E26" />
                    </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CompactProtocolCellTemplate" DataType="{x:Type vm:ProtocolRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="12,4,8,4" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding Description}">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,7,0" VerticalAlignment="Center" />
                <Border Background="#FFEBE9" CornerRadius="7" Padding="5,0" VerticalAlignment="Center"
                        Visibility="{Binding IsDeprecated, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="deprecated" FontSize="10.5" Foreground="#A40E26" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ServerCellTemplate">
            <ContentPresenter Content="{Binding Server}" ContentTemplate="{StaticResource CellTemplate}" />
        </DataTemplate>
        <DataTemplate x:Key="ClientCellTemplate">
            <ContentPresenter Content="{Binding Client}" ContentTemplate="{StaticResource CellTemplate}" />
        </DataTemplate>
        <DataTemplate x:Key="CompactServerCellTemplate">
            <ContentPresenter Content="{Binding Server}" ContentTemplate="{StaticResource CompactCellTemplate}" />
        </DataTemplate>
        <DataTemplate x:Key="CompactClientCellTemplate">
            <ContentPresenter Content="{Binding Client}" ContentTemplate="{StaticResource CompactCellTemplate}" />
        </DataTemplate>

        <DataTemplate x:Key="ResetCellTemplate" DataType="{x:Type vm:ProtocolRowViewModel}">
            <Button Style="{StaticResource LinkButtonStyle}" Content="Reset to OS default" Margin="8,0,16,0" VerticalAlignment="Center"
                    Command="{Binding ResetToOsDefaultCommand}"
                    ToolTip="Stage removal of Enabled/DisabledByDefault for Server and Client so Windows uses its built-in default." />
        </DataTemplate>
        <DataTemplate x:Key="CompactResetCellTemplate" DataType="{x:Type vm:ProtocolRowViewModel}">
            <Button Style="{StaticResource LinkButtonStyle}" Content="Reset" Margin="6,0,12,0" VerticalAlignment="Center"
                    Command="{Binding ResetToOsDefaultCommand}" AutomationProperties.Name="Reset to OS default"
                    ToolTip="Reset to OS default: stage removal of Enabled/DisabledByDefault for Server and Client so Windows uses its built-in default." />
        </DataTemplate>

        <!-- Segmented control for the display mode. -->
        <Style x:Key="SegmentedListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="2">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Foreground" Value="#1F2328" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="4" Padding="14,3" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="CompactHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#1F2328" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F6F8FA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF4FB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding Machines.TogglePanelCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MachinesButton" Content="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                        Command="{Binding Machines.TogglePanelCommand}" MinWidth="0" Padding="10,8" Margin="0,2,16,0" VerticalAlignment="Top"
                        AutomationProperties.Name="Machines" ToolTip="Show or hide the machine list to manage remote computers (Ctrl+M)." />
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <TextBlock Text="Schannel protocols" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border CornerRadius="12" Padding="10,3" VerticalAlignment="Center" Margin="0,4,0,0" ToolTip="{Binding TargetDetail}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EAEEF2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemoteTarget}" Value="True">
                                            <Setter Property="Background" Value="#DDF4FF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" AutomationProperties.Name="Computer">
                                <Run Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <Run Text="{Binding TargetName, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding TargetDetail, Mode=OneWay, StringFormat='· {0}'}" Foreground="{StaticResource MutedTextBrush}" />
                            </TextBlock>
                        </Border>
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                        <Run Text="{Binding OsSummary, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1F2328" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding DefaultsSummary, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding RegistryPath}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16,2,0,0">
                <Border HorizontalAlignment="Right" CornerRadius="12" Padding="12,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DAFBE1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="Background" Value="#FFF8C5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontWeight="SemiBold" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1A7F37" />
                                <Setter Property="Text" Value="{Binding ModeText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                        <Setter Property="Foreground" Value="#7D4E00" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,2,0">
                    <TextBlock Text="{Binding Updates.VersionText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdateStatusText" Text="{Binding Updates.StatusText, StringFormat='  ·  {0}'}" FontSize="12"
                               VerticalAlignment="Center" ToolTip="{Binding Updates.StatusDetail}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Updates.StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Updates.State}" Value="Available">
                                        <Setter Property="Foreground" Value="#0969DA" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="UpdatesButton" Content="Updates ▾" Style="{StaticResource LinkButtonStyle}" FontSize="12" Margin="14,0,0,0"
                            VerticalAlignment="Center" Click="OnUpdatesClick" AutomationProperties.Name="Updates"
                            ToolTip="Check GitHub for a newer CryptoFixer release." />
                </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Machines panel: slides in from the left (Ctrl+M; animated in code-behind). Selecting a machine shows its settings. -->
        <Border x:Name="MachinesPanel" DockPanel.Dock="Left" Width="0" Visibility="Collapsed" ClipToBounds="True"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">

            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding Machines.ClosePanelCommand}" />
            </Border.InputBindings>

            <!-- Fixed width so the content doesn't reflow while the panel slides. -->
            <DockPanel Width="271" HorizontalAlignment="Left">
                <DockPanel DockPanel.Dock="Top" Margin="16,14,10,10">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButtonStyle}" Command="{Binding Machines.ClosePanelCommand}"
                            Padding="6,2" VerticalAlignment="Center" AutomationProperties.Name="Close machine list"
                            ToolTip="Hide the machine list (Ctrl+M or Esc)." />
                    <TextBlock Text="Machines" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="16,0,16,8">
                    <TextBox x:Name="MachineFilterBox" Text="{Binding Machines.FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="24,5,6,5" VerticalContentAlignment="Center" AutomationProperties.Name="Filter machines"
                             ToolTip="Filter by name or host/IP address. Esc clears the filter.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding Machines.ClearFilterCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                    <TextBlock Text="Filter by name or IP" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#8C959F">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=MachineFilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
                    <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Padding="6,4" AutomationProperties.Name="Sort machines by"
                              ItemsSource="{Binding Machines.SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Machines.SortOrder}"
                              ToolTip="Name: alphabetical. IP address: numeric (IPv4, then IPv6, then host names). This computer always stays first." />
                </DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="16,0,16,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="Clear" FontSize="11.5" VerticalAlignment="Center"
                            Command="{Binding Machines.ClearFilterCommand}" AutomationProperties.Name="Clear machine filter"
                            Visibility="{Binding Machines.IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Machines.CountText}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add…" Command="{Binding Machines.AddCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="64"
                                ToolTip="Add a remote computer: name, host name or IP address, and credentials." />
                        <Button Content="Edit…" Command="{Binding Machines.EditCommand}" CommandParameter="{Binding Machines.SelectedItem}" MinWidth="64"
                                ToolTip="Edit the selected remote computer (F2)." ToolTipService.ShowOnDisabled="True" />
                        <Button Content="Remove" Command="{Binding Machines.RemoveCommand}" CommandParameter="{Binding Machines.SelectedItem}" MinWidth="64"
                                ToolTip="Remove the selected remote computer from the list (Delete)." ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                    <TextBlock Text="{Binding Machines.FileName, StringFormat='Saved in {0} next to CryptoFixer.exe. Right-click a machine for more.'}"
                               ToolTip="{Binding Machines.FilePath}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <Grid>
                    <ListBox x:Name="MachineList" ItemsSource="{Binding Machines.ItemsView}" SelectedItem="{Binding Machines.SelectedItem, Mode=TwoWay}"
                             IsSynchronizedWithCurrentItem="False" BorderThickness="0,1" BorderBrush="#EAEEF2" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Machines" PreviewMouseRightButtonDown="OnMachineListPreviewRightButtonDown">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding Machines.RemoveCommand}" CommandParameter="{Binding Machines.SelectedItem}" />
                            <KeyBinding Key="F2" Command="{Binding Machines.EditCommand}" CommandParameter="{Binding Machines.SelectedItem}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,7,8,7" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding StatusToolTip}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MachineItemViewModel}">
                                <DockPanel Background="Transparent" ToolTip="{Binding StatusToolTip}"
                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Connect" Command="{Binding Machines.ConnectCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Edit…" Command="{Binding Machines.EditCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Remove…" Command="{Binding Machines.RemoveCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top" Fill="#AFB8C1" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#BF8700" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Connected">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#1A7F37" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#CF222E" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Top" Margin="16,66,16,0"
                                Visibility="{Binding Machines.HasNoMatches, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No machines match the filter." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource LinkButtonStyle}" Content="Clear filter" HorizontalAlignment="Center" Margin="0,4,0,0"
                                Command="{Binding Machines.ClearFilterCommand}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Update available -->
        <Border DockPanel.Dock="Top" Background="#DDF4FF" BorderBrush="#9CD7FF" BorderThickness="0,0,0,1" Padding="24,10"
                Visibility="{Binding Updates.IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Release notes" Style="{StaticResource LinkButtonStyle}" Command="{Binding Updates.OpenReleaseNotesCommand}"
                            VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Update now…" Command="{Binding Updates.InstallCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding Updates.IsNotDownloading, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Cancel" Command="{Binding Updates.CancelDownloadCommand}"
                            Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="✕" Command="{Binding Updates.DismissCommand}" ToolTip="Hide until the next check" AutomationProperties.Name="Dismiss update notice"
                            Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding Updates.IsNotDownloading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="⬆ Update available: " FontWeight="SemiBold" />
                        <Run Text="{Binding Updates.BannerText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="220" Height="8" Minimum="0" Maximum="100" Value="{Binding Updates.DownloadPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding Updates.IsProgressIndeterminate}" AutomationProperties.Name="Download progress" />
                        <TextBlock Text="{Binding Updates.DownloadText}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Restart notice -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="24,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF8C5" />
                    <Setter Property="BorderBrush" Value="#E7D38B" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                            <Setter Property="Background" Value="#FFEBE9" />
                            <Setter Property="BorderBrush" Value="#F5B5B0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding RestartButtonText}" Command="{Binding RestartCommand}"
                        Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="⟳ Restart required: " FontWeight="SemiBold" />
                    <Run Text="{Binding RestartNotice, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding PendingSummary}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <Button Content="Discard" Command="{Binding DiscardCommand}" />
                    <Button Content="Apply changes…" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="{Binding ApplyToolTip}" ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0" />
                    <Button Content="Export backup…" Command="{Binding ExportBackupCommand}"
                            ToolTip="Save the current SCHANNEL\Protocols settings to a .reg file." />
                    <Button x:Name="PresetsButton" Content="Presets ▾" Click="OnPresetsClick" AutomationProperties.Name="Presets"
                            ToolTip="Load a preset to stage its settings, or save the current settings as a preset. Presets are stored next to CryptoFixer.exe." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status line -->
        <DockPanel DockPanel.Dock="Bottom" Margin="24,8,24,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="Open backup folder" Command="{Binding OpenBackupFolderCommand}"
                    ToolTip="{Binding BackupFolder}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>

        <!-- Search, filter and sort -->
        <DockPanel DockPanel.Dock="Top" Margin="24,14,24,0">
            <WrapPanel>
                <Grid Width="240" Margin="0,0,18,6" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="24,5,6,5" VerticalContentAlignment="Center" AutomationProperties.Name="Search protocols"
                             ToolTip="Search protocol names and descriptions (Ctrl+F). Esc clears the search.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                    <TextBlock Text="Search protocols" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="#8C959F">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                    <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Width="170" Padding="6,4" AutomationProperties.Name="Show"
                              ItemsSource="{Binding StateFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding StateFilter}"
                              ToolTip="Show only protocols whose server or client side (see Side) is in this state." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                    <TextBlock Text="Side" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Width="150" Padding="6,4" AutomationProperties.Name="Side"
                              ItemsSource="{Binding RoleScopeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding RoleScope}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Width="200" Padding="6,4" AutomationProperties.Name="Sort by"
                              ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SortKey}"
                              ToolTip="You can also click a column header: ascending, descending, then back to version order." />
                    <Button Content="{Binding SortDirectionGlyph}" ToolTip="{Binding SortDirectionToolTip}" Command="{Binding ToggleSortDirectionCommand}"
                            MinWidth="0" Padding="10,3" Margin="5,0,0,0" AutomationProperties.Name="Sort direction" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <!-- Result count and display mode -->
        <DockPanel DockPanel.Dock="Top" Margin="24,2,24,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource MutedTextBrush}" />
                <ListBox x:Name="DisplayModeSwitch" Style="{StaticResource SegmentedListBoxStyle}" AutomationProperties.Name="Display mode"
                         ItemsSource="{Binding DisplayModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                         SelectedValue="{Binding DisplayMode}"
                         ToolTip="Standard: full table. Compact: one line per protocol. List: one item per protocol with server and client inline. Remembered next to CryptoFixer.exe." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding VisibleCountText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource LinkButtonStyle}" Content="Clear filters" Margin="10,0,0,0" VerticalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <!-- Protocol grid -->
        <Border Margin="24,8,24,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
            <DataGrid x:Name="ProtocolGrid" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False"
                      Visibility="{Binding IsTableMode, Converter={StaticResource BoolToVisibility}}"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                      CanUserSortColumns="True" Sorting="OnGridSorting" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAEEF2" BorderThickness="0" Background="Transparent" Margin="1"
                      SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource HeaderStyle}" CellStyle="{StaticResource CellStyle}" RowStyle="{StaticResource RowStyle}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      EnableRowVirtualization="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ProtocolColumn" Header="Protocol" Width="3*" MinWidth="220" SortMemberPath="Name"
                                            CellTemplate="{StaticResource ProtocolCellTemplate}" />
                    <DataGridTemplateColumn x:Name="ServerColumn" Header="Server  (incoming connections)" Width="2.4*" MinWidth="230" SortMemberPath="Server"
                                            CellTemplate="{StaticResource ServerCellTemplate}" />
                    <DataGridTemplateColumn x:Name="ClientColumn" Header="Client  (outgoing connections)" Width="2.4*" MinWidth="230" SortMemberPath="Client"
                                            CellTemplate="{StaticResource ClientCellTemplate}" />

                    <DataGridTemplateColumn x:Name="ResetColumn" Header="" Width="Auto" MinWidth="140" CellTemplate="{StaticResource ResetCellTemplate}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- List display mode: same filtered and sorted RowsView, one item per protocol. -->
            <ScrollViewer x:Name="ListScroller" Margin="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}">
                <controls:ProtocolCardList x:Name="ProtocolList" ItemsSource="{Binding RowsView}" Focusable="False"
                                           AutomationProperties.Name="Protocol list" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProtocolRowViewModel}">
                            <controls:ProtocolCard x:Name="Item" Background="White" BorderBrush="#EAEEF2" BorderThickness="0,0,0,1" Padding="18,11,18,9"
                                                   AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="Reset to OS default"
                                                VerticalAlignment="Center" Command="{Binding ResetToOsDefaultCommand}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Reset {0} to OS default'}"
                                                ToolTip="Stage removal of Enabled/DisabledByDefault for Server and Client so Windows uses its built-in default." />
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0" />
                                            <Border Background="#FFEBE9" CornerRadius="8" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDeprecated, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="deprecated" FontSize="11" Foreground="#A40E26" />
                                            </Border>
                                            <Border Background="#FFF1C2" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                                                    Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="pending change" FontSize="11" Foreground="#7D4E00" />
                                            </Border>
                                        </WrapPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,2,0,8" />
                                    <WrapPanel>
                                        <ContentPresenter Content="{Binding Server}" ContentTemplate="{StaticResource ListSideTemplate}"
                                                          Visibility="{Binding DataContext.ShowServerColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                                        <ContentPresenter Content="{Binding Client}" ContentTemplate="{StaticResource ListSideTemplate}"
                                                          Visibility="{Binding DataContext.ShowClientColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </controls:ProtocolCard>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Item" Property="Background" Value="#F6F8FA" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ProtocolCardList>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                        Visibility="{Binding HasNoVisibleRows, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="No protocols match the current search and filters." Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                <Button Style="{StaticResource LinkButtonStyle}" Content="Clear filters" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>

            <!-- Remote connection progress/errors and long-running remote operations. -->
            <Border Background="#F2FFFFFF" CornerRadius="8" Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="32,72,32,0" MaxWidth="580">
                    <StackPanel Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ConnectionTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <ProgressBar IsIndeterminate="True" Width="260" Height="6" Margin="0,16,0,0" AutomationProperties.Name="Connecting" />
                        <Button Content="Cancel" Command="{Binding BackToLocalCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                ToolTip="Stop connecting and show this computer again." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsConnectionFailed, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ConnectionTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#CF222E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionTitle}" Value="Restarting">
                                            <Setter Property="Foreground" Value="#1F2328" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Text="{Binding ConnectionDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,12,0,0" Padding="8,6"
                                 Background="#F6F8FA" BorderBrush="#D0D7DE" AutomationProperties.Name="Error details"
                                 Visibility="{Binding HasConnectionDetail, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Try again" Command="{Binding RetryConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
                            <Button Content="Edit connection…" Command="{Binding EditCurrentMachineCommand}"
                                    ToolTip="Change the host, connection type or credentials of this machine." />
                            <Button Content="Back to this computer" Command="{Binding BackToLocalCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" />
                        <ProgressBar IsIndeterminate="True" Width="260" Height="6" Margin="0,16,0,0" AutomationProperties.Name="Working" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>
